# انسخ هذا الملف إلى .env على الخادم وعدّل القيم — لا ترفع .env نفسه لـ GitHub أبدًا

POSTGRES_DB=masar
POSTGRES_USER=masar
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# الدومين اللي راح يوجّه لـ Caddy عشان يصدر شهادة HTTPS تلقائيًا (لازم يشير DNS له
# قبل التشغيل، وإلا استخدم Cloudflare Tunnel بدلاً من Caddy — راجع deploy/README)
MASAR_DOMAIN=core.example.com

# مفتاح تشفير n8n: لا يُوضع هنا. n8n يولّده تلقائيًا عند أول إقلاع ويحفظه في
# volume n8n_data (الملف /home/node/.n8n/config) — backup.sh ينسخه مشفّرًا.

# B4 — تشفير أسرار البريد (mail_links.secret_enc): يولّده deploy/autodeploy.sh
# تلقائيًا (idempotent) في .env على الخادم أول مرة — لا تولّده يدويًا هنا إلا
# لبيئة تطوير محلية. docker-compose.yml يمرّره لكلتا core/core-scheduler.
# MAIL_FERNET_KEY=

# B4 — وضع الإرسال (افتراضيًا لا شيء منها معرّف = fail-closed، لا إرسال
# إطلاقًا): MAIL_SINK_SMTP/MAIL_SINK_API_URL يستهدفان خدمة mailpit الداخلية
# افتراضيًا (mailpit:1025 / http://mailpit:8025) — لا تُغيَّر عادة. DRY_RUN_TO
# يحوّل كل الإرسال الحقيقي لصندوق واحد بدل مستلمين حقيقيين. MAIL_LIVE=true
# فقط بعد اعتماد المراجع الجودة (راجع PLAN.md قسم B4).
# MAIL_SINK_SMTP=mailpit:1025
# MAIL_SINK_API_URL=http://mailpit:8025
# DRY_RUN_TO=
# MAIL_LIVE=false
