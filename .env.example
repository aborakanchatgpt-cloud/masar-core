# انسخ هذا الملف إلى .env على الخادم وعدّل القيم — لا ترفع .env نفسه لـ GitHub أبدًا

POSTGRES_DB=masar
POSTGRES_USER=masar
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# الدومين اللي راح يوجّه لـ Caddy عشان يصدر شهادة HTTPS تلقائيًا (لازم يشير DNS له
# قبل التشغيل، وإلا استخدم Cloudflare Tunnel بدلاً من Caddy — راجع deploy/README)
MASAR_DOMAIN=core.example.com

# مفتاح تشفير n8n: لا يُوضع هنا. n8n يولّده تلقائيًا عند أول إقلاع ويحفظه في
# volume n8n_data (الملف /home/node/.n8n/config) — backup.sh ينسخه مشفّرًا.

# B4 — تشفير أسرار البريد (mail_links.secret_enc): يولّده deploy/autodeploy.sh
# تلقائيًا (idempotent) في .env على الخادم أول مرة — لا تولّده يدويًا هنا إلا
# لبيئة تطوير محلية. docker-compose.yml يمرّره لكلتا core/core-scheduler.
# MAIL_FERNET_KEY=

# B4 — وضع الإرسال (افتراضيًا لا شيء منها معرّف = fail-closed، لا إرسال
# إطلاقًا): MAIL_SINK_SMTP/MAIL_SINK_API_URL يستهدفان خدمة mailpit الداخلية
# افتراضيًا (mailpit:1025 / http://mailpit:8025) — لا تُغيَّر عادة. DRY_RUN_TO
# يحوّل كل الإرسال الحقيقي لصندوق واحد بدل مستلمين حقيقيين. MAIL_LIVE=true
# فقط بعد اعتماد المراجع الجودة (راجع PLAN.md قسم B4).
# MAIL_SINK_SMTP=mailpit:1025
# MAIL_SINK_API_URL=http://mailpit:8025
# DRY_RUN_TO=
# MAIL_LIVE=false

# B8 — بوتا تيليجرام (يستبدلان n8n بالكامل، وارد وصادر معًا):
# TELEGRAM_CUSTOMER_BOT_TOKEN توكن بوت "مسار" العام (من @BotFather)،
# TELEGRAM_ADMIN_BOT_TOKEN توكن بوت الأدمن الخاص بأحمد فقط. MASAR_OWNER_CHAT_ID
# هو معرّف محادثة تيليجرام الشخصي لأحمد (وليس اسم مستخدم) — يُحصَل عليه
# بمراسلة بوت مثل @userinfobot مرة واحدة. TELEGRAM_WEBHOOK_SECRET توكن عشوائي
# طويل (openssl rand -hex 32 مثلًا) يشكّل مقطع مسار /telegram/webhook/<توكن>
# (نفس نمط MCP_BRIDGE_TOKEN بالضبط) — يُستخدم أيضًا كقيمة secret_token عند
# استدعاء setWebhook لكلا البوتين حتى تُرسل تيليجرام ترويسة
# X-Telegram-Bot-Api-Secret-Token المطابقة (دفاع إضافي فوق توكن المسار).
# غياب أي من التوكنات = تعطيل ذلك الجزء بالكامل (fail-closed)، لا خطأ صامت.
# TELEGRAM_CUSTOMER_BOT_TOKEN=
# TELEGRAM_ADMIN_BOT_TOKEN=
# MASAR_OWNER_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# B8 (الشقّ الصادر — core-scheduler: reports_relay.py/retention.py/
# telegram_notify_admin.py) — TELEGRAM_ADMIN_CHAT_ID اختياري: القيمة
# الافتراضية بالكود نفسه (DEFAULT_ADMIN_CHAT_ID بـtelegram_notify_admin.py)
# هي نفسها MASAR_OWNER_CHAT_ID أعلاه عمليًا (محادثة أحمد الشخصية) — عرّفه
# صراحةً هنا فقط لو اختلف لاحقًا عن MASAR_OWNER_CHAT_ID.
# TELEGRAM_ADMIN_CHAT_ID=

# B8 (نصيحة الجمعة الأسبوعية — skill_gap.py) — مفتاح Anthropic API، اختياري
# تمامًا: بلا قيمة، الجولة الأسبوعية تُسجَّل وتُتخطّى بصمت (لا تعطيل لأي
# جزء آخر). SKILL_GAP_MODEL يتجاوز النموذج الافتراضي بالكود بلا تعديل كود.
# ANTHROPIC_API_KEY=
# SKILL_GAP_MODEL=
