    {"id":"61be77fd-2051-4d56-8ea4-763f4255f9a2","name":"Get Active Customers","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[240,500],"parameters":{"operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"RqFudRWq2sXxEBgT","cachedResultName":"Customers"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"subscriptionStatus","keyValue":"Active"}]},"returnAll":true}},
    {"id":"5296d682-9754-43a8-93fb-98572f73a23a","name":"يوميًا الساعة 9 صباحًا","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.4,"position":[0,700],"parameters":{"rule":{"interval":[{"field":"days","daysInterval":1,"triggerAtHour":9,"triggerAtMinute":0}]}}},
    {"id":"cae306b7-ab69-4b0c-ad8c-17682636262d","name":"Compute Subscription Status","type":"n8n-nodes-base.code","typeVersion":2,"position":[700,500],"parameters":{"mode":"runOnceForEachItem","language":"javaScript","jsCode":"const j = $json;\nconst today = new Date();\ntoday.setUTCHours(0,0,0,0);\nconst todayIso = today.toISOString().slice(0,10);\nlet daysLeft = null;\nif (j.subscriptionEndDate) {\n  const end = new Date(j.subscriptionEndDate);\n  end.setUTCHours(0,0,0,0);\n  daysLeft = Math.round((end.getTime() - today.getTime()) / 86400000);\n}\nlet action = 'none';\nif (daysLeft !== null) {\n  if (daysLeft < 0) {\n    action = 'expire';\n  } else if (daysLeft <= 3 && (j.lastRenewalReminderSent || '') !== todayIso) {\n    action = 'remind';\n  }\n}\nreturn { json: { ...j, daysLeft, action, todayIso } };"}},
    {"id":"9af1e0dc-4736-4deb-be7c-2e9747682b0d","name":"انتهى الاشتراك؟","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[940,500],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"leftValue":"={{ $json.action }}","rightValue":"expire","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}}},
    {"id":"e9198907-deba-42d9-936e-65c9b945a8f6","name":"Mark Subscription Expired","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1180,380],"parameters":{"operation":"update","dataTableId":{"__rl":true,"mode":"id","value":"RqFudRWq2sXxEBgT","cachedResultName":"Customers"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"id","keyValue":"={{ $json.id }}"}]},"columns":{"mappingMode":"defineBelow","value":{"subscriptionStatus":"Expired"},"schema":[{"id":"subscriptionStatus","displayName":"subscriptionStatus","type":"string","canBeUsedToMatch":true}]},"options":{}}},
    {"id":"69bafa05-50df-4c13-8dfb-2812db21be2a","name":"إشعار العميل - انتهاء الاشتراك","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1420,300],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $(\"Compute Subscription Status\").item.json.telegramChatId }}","text":"={{ \"مرحبًا \" + $(\"Compute Subscription Status\").item.json.customerName + \"،\\n\\nنود إعلامك أن اشتراكك في مسار انتهى، وتوقف البحث والتقديم التلقائي لك مؤقتًا.\\n\\nإذا تحب ترجع وتكمل معنا، تواصل معنا على واتساب: +966544161255\\n\\nونتمنى لك التوفيق والرزق الطيّب 🤍\" }}","additionalFields":{}},"webhookId":"1363b414-6f0c-499c-8b0f-ec30bdd0f36d","credentials":{"telegramApi":{"name":"Telegram account"}}},
