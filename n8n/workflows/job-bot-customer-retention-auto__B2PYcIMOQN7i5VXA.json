    {"id":"05b9c77b-66af-433b-97ca-10419559c88f","name":"Mark Reminder Sent","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1180,700],"parameters":{"operation":"update","dataTableId":{"__rl":true,"mode":"id","value":"RqFudRWq2sXxEBgT","cachedResultName":"Customers"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"id","keyValue":"={{ $json.id }}"}]},"columns":{"mappingMode":"defineBelow","value":{"lastRenewalReminderSent":"={{ $json.todayIso }}"},"schema":[{"id":"lastRenewalReminderSent","displayName":"lastRenewalReminderSent","type":"string","canBeUsedToMatch":true}]},"options":{}}},
    {"id":"1af3ce05-1d42-4fec-85c5-1a554d269189","name":"إشعار العميل - تذكير بالتجديد","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1420,620],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $(\"Compute Subscription Status\").item.json.telegramChatId }}","text":"={{ \"مرحبًا \" + $(\"Compute Subscription Status\").item.json.customerName + \" 🌟\\n\\nحبينا نذكرك بود قلب إن اشتراكك في مسار راح ينتهي خلال \" + $(\"Compute Subscription Status\").item.json.daysLeft + \" يوم/أيام (بتاريخ \" + $(\"Compute Subscription Status\").item.json.subscriptionEndDate + \").\\n\\nإذا عجبتك خدماتنا وتحب تكمل معنا بدون انقطاع، بادر بالتواصل معنا على واتساب: +966544161255\\n\\nوإن شاء الله دايم في تيسير ورزق يوصلك 🤍\" }}","additionalFields":{}},"webhookId":"ff683e64-42ba-4b29-b47b-22e2b3d0e024","credentials":{"telegramApi":{"name":"Telegram account"}}},
