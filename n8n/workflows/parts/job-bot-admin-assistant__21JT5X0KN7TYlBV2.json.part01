{"name":"Job Bot - Admin Assistant (Telegram)","nodes":[{"id":"bc96634a-ea72-44be-bb85-d4a481bc4185","name":"Telegram Admin Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.5,"position":[224,208],"parameters":{"updates":["message"],"additionalFields":{}},"webhookId":"4fb7f984-b021-4fb9-96be-45dd82cc1189","credentials":{"telegramApi":{"name":"Telegram Admin Bot"}}},{"id":"8fea3186-e9f3-440c-85b1-47861eced9b5","name":"Normalize Admin Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,112],"parameters":{"mode":"runOnceForEachItem","language":"javaScript","jsCode":"const raw = $json;\nlet chatId = '';\nlet text = '';\nif (raw.message) {\n  chatId = String((raw.message.chat || {}).id || '');\n  text = raw.message.text || '';\n} else {\n  chatId = String(raw.chatId || '');\n  text = raw.text || '';\n}\nreturn { json: { chatId, text } };"}},{"id":"35ab89b0-61b3-4532-9f61-9bbc2bd3afa1","name":"تشغيل يدوي (تجربة)","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,16],"parameters":{}},{"id":"be00203d-4dc1-4620-96e8-ce9e4c9189df","name":"Test Input Override","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[224,16],"parameters":{"mode":"manual","assignments":{"assignments":[{"id":"a1","name":"chatId","value":"677475661","type":"string"},{"id":"a2","name":"text","value":"/start","type":"string"}]},"options":{}}},{"id":"8652c86b-292b-422a-b4e3-6270da71561c","name":"Is Ahmed?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[672,112],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.chatId }}","operator":{"type":"string","operation":"equals"},"rightValue":"677475661"}],"combinator":"and"}}},{"id":"0199571c-8deb-44a9-9f82-b70e208475aa","name":"وكيل الإدارة","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[1088,112],"parameters":{"promptType":"define","text":"=التاريخ الحالي: {{ $today.toISODate() }}\nرسالة أحمد عبر بوت الإدارة: {{ $('Normalize Admin Input').item.json.text }}","options":{"systemMessage":"أنت مساعد إداري خاص بأحمد، مالك خدمة بوت التقديم على الوظائف. تتحدث معك أنت فقط (أحمد) عبر بوت تيليجرام إداري منفصل تمامًا عن بوت العملاء. مهمتك الأساسية:\n\n1. لما تخبرني إنك أكدت استلام دفعة من عميل جديد، اجمع منه ثلاث معلومات إن لم تُذكر: رقم جواله، مدة الاشتراك بالأيام (لو قال \"شهر\" فهمها 30 يوم، \"3 أشهر\" = 90 يوم... إلخ)، والرسوم الشهرية بالريال. اسأل سؤالًا واحدًا فقط عن أي معلومة ناقصة، ولا تخترع أي قيمة لم تُذكر.\n2. بمجرد اكتمال المعلومات الثلاث، نظّف رقم الجوال (احذف المسافات والشرطات وعلامة +) واستدعِ الأداة AddPendingApproval، ثم أكد لي بإيجاز أنه تمت الإضافة.\n3. إذا سألتك \"مين لسا ما سجل\" أو ما شابه، استخدم أداة ListPendingApprovals.\n4. إذا سألتك عن العملاء الحاليين أو النشطين، استخدم أداة ListActiveCustomers.\n5. كن مختصرًا ومباشرًا بلهجة عملية، بدون رموز تعبيرية زائدة أو مقدمات طويلة — أنت تتحدث مع مالك الخدمة نفسه، مو عميل.\n\nلا تستدعِ أي أداة تعديل بيانات إلا بعد تأكيد صريح مني.","maxIterations":10}}},{"id":"22fa2805-7f2c-4345-8ac1-04868b4b333c","name":"Anthropic Model (Admin)","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.5,"position":[896,336],"parameters":{"model":{"__rl":true,"mode":"list","value":"claude-sonnet-4-6","cachedResultName":"Claude Sonnet 4.6"},"options":{}},"credentials":{"anthropicApi":{"name":"Anthropic account"}}},{"id":"7a6d125b-c0dd-4a7a-b01a-e7ca4f51e8ab","name":"Admin Memory","type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","typeVersion":1.4,"position":[1024,336],"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Normalize Admin Input').item.json.chatId }}","contextWindowLength":20}},{"id":"05532474-cd4d-4894-bbc1-89fa131b425d","name":"AddPendingApproval","type":"n8n-nodes-base.dataTableTool","typeVersion":1.1,"position":[1152,336],"parameters":{"resource":"row","operation":"insert","dataTableId":{"__rl":true,"mode":"id","value":"Rnlo1aVbOJhC8NWR","cachedResultName":"Pending Approvals"},"columns":{"mappingMode":"defineBelow","value":{"whatsappNumber":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('whatsappNumber', 'رقم جوال العميل بعد إزالة أي مسافات أو شرطات أو علامة +') }}","subscriptionDurationDays":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('subscriptionDurationDays', 'عدد أيام الاشتراك كما ذكره أحمد (مثلاً شهر = 30)', 'number') }}","monthlyFee":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('monthlyFee', 'قيمة الاشتراك الشهري بالريال كما ذكرها أحمد', 'number') }}","notes":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('notes', 'أي ملاحظات إضافية ذكرها أحمد عن هذا العميل، أو نص فارغ إن لم يذكر شيء') }}","used":false},"schema":[{"id":"whatsappNumber","displayName":"whatsappNumber","type":"string","canBeUsedToMatch":true},{"id":"subscriptionDurationDays","displayName":"subscriptionDurationDays","type":"number","canBeUsedToMatch":true},{"id":"monthlyFee","displayName":"monthlyFee","type":"number","canBeUsedToMatch":true},{"id":"notes","displayName":"notes","type":"string","canBeUsedToMatch":true},{"id":"used","displayName":"used","type":"boolean","canBeUsedToMatch":true}]},"toolDescription":"أضف عميلًا جديدًا لقائمة الموافقات المعلّقة (Pending Approvals) بعد ما يؤكد أحمد صراحة أنه استلم الدفعة من هذا العميل ويريد إضافته."}},{"id":"6a051f4d-f245-4f78-87c9-79600d1cf6b6","name":"ListPendingApprovals","type":"n8n-nodes-base.dataTableTool","typeVersion":1.1,"position":[1280,336],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"Rnlo1aVbOJhC8NWR","cachedResultName":"Pending Approvals"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"used","condition":"eq","keyValue":"false"}]},"returnAll":true,"toolDescription":"اعرض كل العملاء المضافين للموافقات المعلّقة ولم يكملوا التسجيل بعد عبر بوت العملاء (used=false)."}},{"id":"6a2f6f4a-8291-44d5-8433-529556067723","name":"ListActiveCustomers","type":"n8n-nodes-base.dataTableTool","typeVersion":1.1,"position":[1408,336],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"RqFudRWq2sXxEBgT","cachedResultName":"Customers"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"subscriptionStatus","condition":"eq","keyValue":"Active"}]},"returnAll":true,"toolDescription":"اعرض كل العملاء الحاليين الذين اشتراكهم فعّال (Active) مع تفاصيلهم الأساسية."}},{"id":"1418d156-4566-4a5c-89c3-1fdf4476b95d","name":"Send Admin Reply","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1616,112],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $('Normalize Admin Input').item.json.chatId }}","text":"={{ $json.output }}","replyMarkup":"replyKeyboard","replyKeyboard":{"rows":[{"row":{"buttons":[{"text":"➕ عميل جديد"},{"text":"🔄 تفعيل/إلغاء عميل"}]}},{"row":{"buttons":[{"text":"⏱️ تمديد اشتراك"},{"text":"🔎 تقرير عميل"}]}},{"row":{"buttons":[{"text":"👥 حالة العملاء"},{"text":"💰 التقرير المالي"}]}},{"row":{"buttons":[{"text":"💰 إضافة تكلفة"},{"text":"✉️ رسالة للعملاء"}]}}]},"replyKeyboardOptions":{"resize_keyboard":true},"additionalFields":{"appendAttribution":false}},"webhookId":"0c1987d9-53b8-4a3e-ad82-b197901911e4","credentials":{"telegramApi":{"name":"Telegram Admin Bot"}}},{"id":"4b3753a5-8991-4c19-aac9-b56444fe6624","name":"Get Admin Session","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[900,-100],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"F4UAPZYnSB6YjqvL","cachedResultName":"AdminSession"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"chatId","condition":"eq","keyValue":"={{ $json.chatId }}"}]},"returnAll":true},"alwaysOutputData":true},{"id":"f35dd467-43fd-49a0-a103-88c640903b3d","name":"Admin Router","type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,-100],"parameters":{"mode":"runOnceForEachItem","language":"javaScript","jsCode":"const norm = $('Normalize Admin Input').item.json;\nconst text = (norm.text || '').trim();\nconst sess = $json || {};\nconst hasSession = !!(sess && sess.step);\nconst step = hasSession ? sess.step : null;\n\nconst MENU_NEW = '➕ عميل جديد';\nconst MENU_REPORT_ONE = '🔎 تقرير عميل';\nconst MENU_TOGGLE = '🔄 تفعيل/إلغاء عميل';\nconst MENU_EXTEND = '⏱️ تمديد اشتراك';\nconst EXTEND_ADD = '➕ تمديد';\nconst EXTEND_SUBTRACT = '➖ تقليص';\nconst MENU_PENDING = '📋 قائمة الانتظار';\nconst MENU_ACTIVE = '👥 حالة العملاء';\nconst MENU_FINANCIAL = '💰 التقرير المالي';\nconst MENU_MESSAGE = '✉️ رسالة للعملاء';\nconst MENU_COST = '💰 إضافة تكلفة';\nconst CANCEL = '❌ إلغاء';\nconst OTHER_DURATION = 'مدة أخرى';\nconst OTHER_FEE = 'مبلغ آخر';\nconst NO_NOTES = 'بدون ملاحظات';\nconst ADD_NOTES = '✅️ إضافة ملاحظة';\nconst START_IMMEDIATE = '▶️ يبدأ فور تسجيل العميل';\nconst START_FIXED = '🗓️ تاريخ محدد';\nconst ACTIVATE = '✅ تفعيل الاشتراك';\nconst DEACTIVATE = '❌ إلغاء الاشتراك';\nconst TARGET_SINGLE = '📱 عميل محدد';\nconst TARGET_ALL_ACTIVE = '📢 كل المشتركين النشطين';\nconst TARGET_ALL_EXPIRED = '🔔 من انتهى اشتراكه بدون تجديد';\nconst COST_TODAY = 'اليوم';\nconst COST_OTHER_DATE = 'تاريخ آخر';\nconst REPORT_DAILY = '📅 يومي';\nconst REPORT_WEEKLY = '🗓️ أسبوعي';\nconst REPORT_MONTHLY = '📆 شهري';\nconst REPORT_FULL = '📊 تقرير شامل';\n\nconst durationMap = { 'أسبوع': 7, 'شهر': 30, '3 أشهر': 90, '6 أشهر': 180, 'سنة': 365 };\nconst extendMap = { '7 أيام': 7, '30 يوم': 30, '90 يوم': 90 };\n\nlet route = 'fallback_agent';\nlet replyText = '';\nlet keyboardType = 'main';\nlet sessionOp = 'none';\nlet sessionData = {\n  chatId: norm.chatId,\n  step: sess.step || '',\n  whatsappNumber: sess.whatsappNumber || '',\n  durationDays: sess.durationDays || 0,\n  monthlyFee: sess.monthlyFee || 0,\n  notes: sess.notes || '',\n  startMode: sess.startMode || '',\n  fixedStartDate: sess.fixedStartDate || ''\n};\n\nfunction resetSession(newStep, extra) {\n  sessionData = Object.assign({ chatId: norm.chatId, step: newStep, whatsappNumber: '', durationDays: 0, monthlyFee: 0, notes: '', startMode: '', fixedStartDate: '' }, extra || {});\n}\n\nif (hasSession && text === CANCEL) {\n  route = 'direct_reply';\n  replyText = '❌ تم إلغاء العملية.\n\nاختر من القائمة:';\n  keyboardType = 'main';\n  sessionOp = 'delete';\n} else if (!hasSession) {\n  if (text === MENU_NEW) {\n    route = 'direct_reply';\n    replyText = '📱 أرسل رقم جوال العميل:';\n    keyboardType = 'cancel';\n    sessionOp = 'upsert';\n    resetSession('awaiting_phone');\n  } else if (text === MENU_ACTIVE) {\n    route = 'list_active';\n  } else if (text === MENU_FINANCIAL) {\n    route = 'financial_report';\n  } else if (text === MENU_REPORT_ONE) {\n    route = 'direct_reply';\n    replyText = '📱 أرسل رقم جوال العميل للحصول على تقريره:';\n    keyboardType = 'cancel';\n    sessionOp = 'upsert';\n    resetSession('awaiting_report_phone');\n  } else if (text === MENU_TOGGLE) {\n    route = 'direct_reply';\n    replyText = '📱 أرسل رقم جوال العميل:';\n    keyboardType = 'cancel';\n    sessionOp = 'upsert';\n    resetSession('awaiting_toggle_phone');\n  } else if (text === MENU_EXTEND) {\n    route = 'direct_reply';\n    replyText = '📱 أرسل رقم جوال العميل:';\n    keyboardType = 'cancel';\n    sessionOp = 'upsert';\n    resetSession('awaiting_extend_phone');\n  } else if (text === MENU_MESSAGE) {\n    route = 'direct_reply';\n    replyText = '✉️ اختر الفئة المستهدفة:';\n    keyboardType = 'message_target';\n    sessionOp = 'upsert';\n    resetSession('awaiting_message_target');\n  } else if (text === MENU_COST) {\n    route = 'direct_reply';\n    replyText = '💰 أدخل المبلغ (رقم):';\n    keyboardType = 'cancel';\n    sessionOp = 'upsert';\n    resetSession('awaiting_cost_amount');\n  } else {\n    route = 'fallback_agent';\n  }\n} else {\n  if (step === 'awaiting_phone') {\n    const cleaned = text.replace(/[^0-9]/g, '');\n    if (cleaned.length < 9) {\n      route = 'direct_reply';\n      replyText = '⚠️ رقم غير صحيح. أرسل رقم الجوال مرة أخرى (أرقام فقط):';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    } else {\n      route = 'direct_reply';\n      replyText = '⏳ اختر مدة الاشتراك:';\n      keyboardType = 'duration';\n      sessionOp = 'upsert';\n      resetSession('awaiting_duration', { whatsappNumber: cleaned });\n    }\n  } else if (step === 'awaiting_duration') {\n    if (durationMap[text]) {\n      route = 'direct_reply';\n      replyText = '🚀 متى يبدأ اشتراك العميل؟';\n      keyboardType = 'start_choice';\n      sessionOp = 'upsert';\n      resetSession('awaiting_start_choice', { whatsappNumber: sess.whatsappNumber, durationDays: durationMap[text] });\n    } else if (text === OTHER_DURATION) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل عدد أيام الاشتراك (رقم):';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_custom_duration', { whatsappNumber: sess.whatsappNumber });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة أو اضغط \"مدة أخرى\".';\n      keyboardType = 'duration';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_custom_duration') {\n    const n = parseInt(text, 10);\n    if (!isNaN(n) && n > 0) {\n      route = 'direct_reply';\n      replyText = '🚀 متى يبدأ اشتراك العميل؟';\n      keyboardType = 'start_choice';\n      sessionOp = 'upsert';\n      resetSession('awaiting_start_choice', { whatsappNumber: sess.whatsappNumber, durationDays: n });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ أرسل رقمًا صحيحًا لعدد الأيام:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_start_choice') {\n    if (text === START_IMMEDIATE) {\n      route = 'direct_reply';\n      replyText = '💰 اختر قيمة الاشتراك الشهري (ريال):';\n      keyboardType = 'fee';\n      sessionOp = 'upsert';\n      resetSession('awaiting_fee', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, startMode: 'immediate' });\n    } else if (text === START_FIXED) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل تاريخ بداية الاشتراك (مثال: 2026-09-10):';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_fixed_date', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة.';\n      keyboardType = 'start_choice';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_fixed_date') {\n    const m = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);\n    if (m) {\n      route = 'direct_reply';\n      replyText = '💰 اختر قيمة الاشتراك الشهري (ريال):';\n      keyboardType = 'fee';\n      sessionOp = 'upsert';\n      resetSession('awaiting_fee', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, startMode: 'fixed', fixedStartDate: text });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ الصيغة غير صحيحة. أرسل التاريخ بصيغة YYYY-MM-DD مثل 2026-09-10:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_fee') {\n    if (['50', '100', '150', '200'].includes(text)) {\n      route = 'direct_reply';\n      replyText = '📝 هل لديك ملاحظات على هذا العميل؟';\n      keyboardType = 'notes';\n      sessionOp = 'upsert';\n      resetSession('awaiting_notes', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, monthlyFee: parseInt(text, 10), startMode: sess.startMode, fixedStartDate: sess.fixedStartDate });\n    } else if (text === OTHER_FEE) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل قيمة الاشتراك الشهري بالريال (رقم):';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_custom_fee', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, startMode: sess.startMode, fixedStartDate: sess.fixedStartDate });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة أو اضغط \"مبلغ آخر\".';\n      keyboardType = 'fee';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_custom_fee') {\n    const n = parseFloat(text);\n    if (!isNaN(n) && n > 0) {\n      route = 'direct_reply';\n      replyText = '📝 هل لديك ملاحظات على هذا العميل؟';\n      keyboardType = 'notes';\n      sessionOp = 'upsert';\n      resetSession('awaiting_notes', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, monthlyFee: n, startMode: sess.startMode, fixedStartDate: sess.fixedStartDate });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ أرسل رقمًا صحيحًا للمبلغ:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_notes') {\n    if (text === NO_NOTES) {\n      route = 'save_customer';\n      resetSession('done', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, monthlyFee: sess.monthlyFee, startMode: sess.startMode, fixedStartDate: sess.fixedStartDate, notes: '' });\n    } else if (text === ADD_NOTES) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل الملاحظة:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_custom_note', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, monthlyFee: sess.monthlyFee, startMode: sess.startMode, fixedStartDate: sess.fixedStartDate });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة.';\n      keyboardType = 'notes';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_custom_note') {\n    route = 'save_customer';\n    resetSession('done', { whatsappNumber: sess.whatsappNumber, durationDays: sess.durationDays, monthlyFee: sess.monthlyFee, startMode: sess.startMode, fixedStartDate: sess.fixedStartDate, notes: text });\n  } else if (step === 'awaiting_report_phone') {\n    const cleaned = text.replace(/[^0-9]/g, '');\n    if (cleaned.length < 9) {\n      route = 'direct_reply';\n      replyText = '⚠️ رقم غير صحيح. أرسل رقم الجوال مرة أخرى:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    } else {\n      route = 'direct_reply';\n      replyText = '📊 اختر نوع التقرير:';\n      keyboardType = 'report_period';\n      sessionOp = 'upsert';\n      resetSession('awaiting_report_period', { whatsappNumber: cleaned });\n    }\n  } else if (step === 'awaiting_report_period') {\n    const periodMap = { [REPORT_DAILY]: 'daily', [REPORT_WEEKLY]: 'weekly', [REPORT_MONTHLY]: 'monthly', [REPORT_FULL]: 'full' };\n    if (periodMap[text]) {\n      route = 'customer_report';\n      resetSession('done', { whatsappNumber: sess.whatsappNumber, notes: periodMap[text] });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة.';\n      keyboardType = 'report_period';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_toggle_phone') {\n    const cleaned = text.replace(/[^0-9]/g, '');\n    if (cleaned.length < 9) {\n      route = 'direct_reply';\n      replyText = '⚠️ رقم غير صحيح. أرسل رقم الجوال مرة أخرى:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    } else {\n      route = 'direct_reply';\n      replyText = 'اختر الإجراء المطلوب لهذا العميل:';\n      keyboardType = 'toggle_action';\n      sessionOp = 'upsert';\n      resetSession('awaiting_toggle_action', { whatsappNumber: cleaned });\n    }\n  } else if (step === 'awaiting_toggle_action') {\n    if (text === ACTIVATE || text === DEACTIVATE) {\n      route = 'toggle_apply';\n      resetSession('done', { whatsappNumber: sess.whatsappNumber, notes: text === ACTIVATE ? 'activate' : 'deactivate' });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة.';\n      keyboardType = 'toggle_action';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_extend_phone') {\n    const cleaned = text.replace(/[^0-9]/g, '');\n    if (cleaned.length < 9) {\n      route = 'direct_reply';\n      replyText = '⚠️ رقم غير صحيح. أرسل رقم الجوال مرة أخرى:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    } else {\n      route = 'direct_reply';\n      replyText = '⏱️ تمديد الاشتراك أو تقليصه؟';\n      keyboardType = 'extend_action';\n      sessionOp = 'upsert';\n      resetSession('awaiting_extend_action', { whatsappNumber: cleaned });\n    }\n  } else if (step === 'awaiting_extend_action') {\n    if (text === EXTEND_ADD || text === EXTEND_SUBTRACT) {\n      route = 'direct_reply';\n      replyText = text === EXTEND_ADD ? '⏳ كم عدد الأيام التي تريد إضافتها للاشتراك؟' : '⏳ كم عدد الأيام التي تريد خصمها من الاشتراك؟';\n      keyboardType = 'extend_days';\n      sessionOp = 'upsert';\n      resetSession('awaiting_extend_days', { whatsappNumber: sess.whatsappNumber, notes: text === EXTEND_ADD ? 'add' : 'subtract' });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة.';\n      keyboardType = 'extend_action';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_extend_days') {\n    if (extendMap[text]) {\n      route = 'extend_apply';\n      resetSession('done', { whatsappNumber: sess.whatsappNumber, durationDays: extendMap[text], notes: sess.notes });\n    } else if (text === OTHER_DURATION) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل عدد الأيام (رقم):';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_extend_custom_days', { whatsappNumber: sess.whatsappNumber, notes: sess.notes });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة أو اضغط \"مدة أخرى\".';\n      keyboardType = 'extend_days';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_extend_custom_days') {\n    const n = parseInt(text, 10);\n    if (!isNaN(n) && n > 0) {\n      route = 'extend_apply';\n      resetSession('done', { whatsappNumber: sess.whatsappNumber, durationDays: n, notes: sess.notes });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ أرسل رقمًا صحيحًا لعدد الأيام:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_message_target') {\n    if (text === TARGET_SINGLE) {\n      route = 'direct_reply';\n      replyText = '📱 أرسل رقم جوال العميل:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_message_phone');\n    } else if (text === TARGET_ALL_ACTIVE) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل نص الرسالة المراد إرسالها لكل المشتركين النشطين:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_message_text', { startMode: 'all_active' });\n    } else if (text === TARGET_ALL_EXPIRED) {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل نص الرسالة المراد إرسالها لمن انتهى اشتراكه بدون تجديد:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_message_text', { startMode: 'all_expired' });\n    } else {\n      route = 'direct_reply';\n      replyText = '⚠️ اختر من القائمة.';\n      keyboardType = 'message_target';\n      sessionOp = 'upsert';\n    }\n  } else if (step === 'awaiting_message_phone') {\n    const cleaned = text.replace(/[^0-9]/g, '');\n    if (cleaned.length < 9) {\n      route = 'direct_reply';\n      replyText = '⚠️ رقم غير صحيح. أرسل رقم الجوال مرة أخرى:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    } else {\n      route = 'direct_reply';\n      replyText = '✏️ أرسل نص الرسالة:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n      resetSession('awaiting_message_text', { whatsappNumber: cleaned, startMode: 'single' });\n    }\n  } else if (step === 'awaiting_message_text') {\n    if (!text) {\n      route = 'direct_reply';\n      replyText = '⚠️ أرسل نص الرسالة:';\n      keyboardType = 'cancel';\n      sessionOp = 'upsert';\n    } else {\n      route = 'send_message';\n      resetSession('done', { whatsappNumber: sess.whatsappNumber, startMode